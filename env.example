# =============================================================================
# DAILY JOURNAL APP - Environment Configuration
# =============================================================================
# Copy this file to .env and customize values:
#   cp env.example .env
#
# Or use the task command:
#   task setup-env
# =============================================================================

# --- Application ---
APP_ENV=development                    # development | production

# --- Server ---
HTTP_PORT=8080                         # Backend API port

# --- Database (SurrealDB) ---
DB_HOST=localhost                      # Use 'surrealdb' in Docker
DB_PORT=8000                           # SurrealDB port
DB_USER=root                           # Database username
DB_PASS=root                           # Database password (CHANGE in production!)
DB_NAMESPACE=daily_journal             # SurrealDB namespace
DB_DATABASE=core                       # SurrealDB database name
DB_SCHEMA_PATH=db/schema.surql         # Path to schema file

# --- Authentication ---
JWT_SECRET=                            # REQUIRED in production! Generate with: openssl rand -hex 32
                                       # Leave empty in dev to auto-generate (won't persist across restarts)

# --- Admin Account (dev/test only) ---
ADMIN_USERNAME=admin@example.com       # Seeded admin email
ADMIN_PASSWORD=adminadmin              # Seeded admin password (CHANGE in production!)

# --- CORS (production only) ---
CORS_ALLOWED_ORIGINS=                  # Comma-separated origins, e.g.: https://example.com,https://app.example.com

# --- Logging ---
LOG_LEVEL=info                         # debug | info | warn | error

# =============================================================================
# Docker-specific overrides (used by docker-compose)
# =============================================================================
# These map host ports to container ports when running in Docker
HOST_APP_PORT=8080                     # Host port for backend
HOST_DB_PORT=8000                      # Host port for database



# Environment Variables

# API URL - Go backend
VITE_API_URL=http://localhost:8080

# Dev Auth Bypass - Auto-login with these credentials instead of showing login form
# Set to "true" to enable dev mode auto-login
VITE_DEV_AUTH_BYPASS=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
