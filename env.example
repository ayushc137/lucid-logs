# ==============================================================================
# LUCID LOGS - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize:
#   cp env.example .env
#
# This single file configures both the Go backend AND Svelte frontend.
# Docker Compose also reads from this file.
# ==============================================================================

# --- Environment ---
APP_ENV=development                     # development | production

# --- Backend Server ---
HTTP_PORT=8080                          # Go API port

# --- Database (Turso/libSQL) ---
# Three modes, selected by which variables are set:
#   1. Local file only:      set LIBSQL_LOCAL_PATH
#   2. Local + remote sync:  set LIBSQL_LOCAL_PATH + LIBSQL_URL + LIBSQL_AUTH_TOKEN
#   3. Remote URL + token:   set LIBSQL_URL + LIBSQL_AUTH_TOKEN (LIBSQL_LOCAL_PATH optional, defaults below)
LIBSQL_LOCAL_PATH=./data/lucid-logs.db  # Local libSQL database file (or replica when syncing)
LIBSQL_URL=                             # Turso remote URL, e.g. libsql://your-db.turso.io (empty = local only)
LIBSQL_AUTH_TOKEN=                      # Turso auth token (required when LIBSQL_URL is set)
DATABASE_MIGRATIONS_PATH=../../db/migrations  # SQL migrations directory (relative to apps/go_backend)

# Legacy aliases (still accepted; LIBSQL_* takes precedence):
# DATABASE_PATH, TURSO_DATABASE_URL, TURSO_AUTH_TOKEN

# --- Authentication ---
JWT_SECRET=                             # REQUIRED in production! Generate: openssl rand -base64 32
                                        # Leave empty in dev to auto-generate (won't persist across restarts)

# --- Admin Account (Development Only) ---
ADMIN_USERNAME=admin@example.com        # Seeded admin email
ADMIN_PASSWORD=adminadmin               # Seeded admin password

# --- CORS (Production Only) ---
CORS_ALLOWED_ORIGINS=                   # Comma-separated origins: https://example.com,https://app.example.com

# --- Docker Port Mapping ---
HOST_APP_PORT=8080                      # Host port → backend container

# ==============================================================================
# Frontend (Vite) - Variables must start with VITE_
# ==============================================================================


# --- Dev Auth Bypass ---
# Automatically logs in with admin credentials (dev mode only)
VITE_DEV_AUTH_BYPASS=true               # Set to 'true' to enable
VITE_DEV_ADMIN_EMAIL=admin@example.com
VITE_DEV_ADMIN_PASSWORD=adminadmin
