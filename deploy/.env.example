# Lucid Logs — environment for the all-in-one container
# Copy to .env and fill in. Compose reads this automatically.

# Port the app is published on (host side).
HTTP_PORT=8080

# REQUIRED — session/JWT signing secret. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# First-run admin account. Created only when the database has no users yet,
# so it's safe to leave these set after the first boot.
ADMIN_SEED=true
ADMIN_USERNAME=you@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: pre-fill AI / LLM settings (bring-your-own-key). The app works
# fully without these; they only pre-populate the Settings screen.
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=
