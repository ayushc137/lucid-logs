            "properties": {
                "color": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "#3B82F6"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Work"
                }
            }
        },
        "categories.UpdateRequest": {
            "description": "Request payload for updating a category",
