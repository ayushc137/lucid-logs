                "title"
            ],
            "properties": {
                "category_id": {
                    "type": "string",
                    "example": "categories:work123"
                },
                "end_date": {
                    "type": "string",
                    "example": "2025-11-25T17:00:00Z"
                },
                "journal": {
                    "type": "string",
                    "maxLength": 10000,
                    "example": "Capture high-level goals"
                },
                "negatives": {
                    "type": "array",
