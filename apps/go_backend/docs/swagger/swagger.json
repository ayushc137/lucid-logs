                        "type": "string"
                    },
                    "example": [
                        "Some distractions"
                    ]
                },
                "note": {
                    "type": "string",
                    "maxLength": 5000,
                    "example": "Focus on top priorities"
                },
                "positives": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Great progress",
                        "In flow"
                    ]
                },
                "priority": {
                    "type": "integer",
                    "maximum": 100,
                    "minimum": -100,
                    "example": 1
