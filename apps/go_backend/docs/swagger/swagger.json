                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Personal"
                }
            }
        },
        "errors.ErrorCode": {
            "type": "string",
            "enum": [
                "BAD_REQUEST",
                "VALIDATION_FAILED",
                "UNAUTHORIZED",
                "FORBIDDEN",
                "NOT_FOUND",
                "CONFLICT",
                "TOO_MANY_REQUESTS",
                "INTERNAL_ERROR",
                "DATABASE_ERROR",
                "SERVICE_UNAVAILABLE"
            ],
            "x-enum-varnames": [
                "CodeBadRequest",
                "CodeValidationFailed",
                "CodeUnauthorized",
                "CodeForbidden",
                "CodeNotFound",
                "CodeConflict",
                "CodeTooManyRequests",
                "CodeInternalError",
                "CodeDatabaseError",
                "CodeServiceError"
