# =============================================================================
# Daily Journal Go Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment

# Application
APP_ENV=development        # development, staging, production
APP_NAME="Lucid Logs"
APP_VERSION=1.0.0

# Server
HTTP_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# Database (SurrealDB)
DB_HOST=localhost
DB_PORT=8000
DB_USER=root
DB_PASS=root
DB_NAMESPACE=daily_journal
DB_DATABASE=core
DB_SCHEMA_PATH=../../db/schema.surql
DB_MIGRATIONS_PATH=../../db/migrations

# JWT Authentication
# REQUIRED in production - generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=lucid-logs

# Admin User (for initial seeding)
# Set these to create an admin user on startup
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=adminadmin

# CORS
# Comma-separated list of allowed origins (leave empty for all in development)
CORS_ALLOWED_ORIGINS=

