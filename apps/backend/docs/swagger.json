{
    "swagger": "2.0",
    "info": {
        "description": "Backend for the Daily Journal Application",
        "title": "Daily Journal API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Login and receive a JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login to SurrealDB",
                "parameters": [
                    {
                        "description": "Credentials",
                        "name": "creds",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.AuthRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.AuthResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Credentials",
                        "name": "creds",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.AuthRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.AuthResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Checks if the API is running",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health Check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/tasks": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "List all tasks",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 25,
                        "description": "Number of tasks to return (max 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Number of tasks to skip",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Task"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a detailed task with validation",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Create a new task",
                "parameters": [
                    {
                        "description": "Task content",
                        "name": "task",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.CreateTaskRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.Task"
                        }
                    }
                }
            }
        },
        "/tasks/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Get a task by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Task ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Task"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Update a task",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Task ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Task update",
                        "name": "task",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.UpdateTaskRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Task"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Delete a task",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Task ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        }
    },
    "definitions": {
        "model.AuthRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "adminadmin"
                },
                "username": {
                    "type": "string",
                    "example": "admin@example.com"
                }
            }
        },
        "model.AuthResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "description": "User ID",
                    "type": "string"
                }
            }
        },
        "model.CreateTaskRequest": {
            "type": "object",
            "required": [
                "end_date",
                "start_date",
                "title"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Capture high-level goals"
                },
                "end_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-25T00:00:00Z"
                },
                "negative_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "note": {
                    "type": "string"
                },
                "positive_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "priority": {
                    "type": "integer"
                },
                "source": {
                    "type": "string",
                    "default": "manual",
                    "enum": [
                        "manual"
                    ]
                },
                "start_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-24T00:00:00Z"
                },
                "title": {
                    "type": "string",
                    "example": "Plan tomorrow"
                }
            }
        },
        "model.Task": {
            "type": "object",
            "required": [
                "end_date",
                "start_date",
                "title"
            ],
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "created_by": {
                    "description": "User ID",
                    "type": "string"
                },
                "deleted_at": {
                    "description": "Soft delete",
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "example": "Capture high-level goals"
                },
                "end_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-25T00:00:00Z"
                },
                "id": {
                    "type": "string"
                },
                "is_completed": {
                    "description": "Status \u0026 Priority",
                    "type": "boolean",
                    "example": false
                },
                "negative_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "[\"Got distracted\"]"
                    ]
                },
                "note": {
                    "description": "Content",
                    "type": "string",
                    "example": "Focus on top priorities"
                },
                "planned": {
                    "description": "Auto-calculated",
                    "type": "boolean",
                    "example": true
                },
                "positive_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "[\"Felt great\"",
                        "\"In flow\"]"
                    ]
                },
                "priority": {
                    "description": "-ve = wishes, higher = higher priority",
                    "type": "integer",
                    "example": 1
                },
                "source": {
                    "description": "Metadata",
                    "type": "string",
                    "default": "manual",
                    "enum": [
                        "manual"
                    ],
                    "example": "manual"
                },
                "start_date": {
                    "description": "Time tracking",
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-24T00:00:00Z"
                },
                "title": {
                    "type": "string",
                    "example": "Plan tomorrow"
                },
                "updated_at": {
                    "type": "string"
                },
                "updated_by": {
                    "description": "User ID",
                    "type": "string"
                }
            }
        },
        "model.UpdateTaskRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "end_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-27T00:00:00Z"
                },
                "is_completed": {
                    "type": "boolean"
                },
                "negative_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "note": {
                    "type": "string"
                },
                "positive_comments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "priority": {
                    "type": "integer"
                },
                "start_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-11-26T00:00:00Z"
                },
                "title": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}